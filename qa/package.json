    "responsive": "node tests/responsive.js",
    "tts": "node tests/tts.js",
    "multibook": "node tests/multibook.js",
    "scroll": "node tests/scroll-follow.js"
  },
  "devDependencies": {
    "axe-core": "^4.12.0",
    "puppeteer": "^25.0.0"
  }
}
