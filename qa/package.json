{
  "name": "a11y-book-reader-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Headless-Chromium QA harness for the A11y Book Reader Jellyfin plugin (functional / WCAG a11y / responsive / TTS), run against a live Jellyfin server.",
  "scripts": {
    "qa": "node run-all.js",
    "functional": "node tests/functional.js",
