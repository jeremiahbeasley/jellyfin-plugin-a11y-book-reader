<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.A11yBookReader</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.A11yBookReader</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Plugin folder must contain dependency DLLs (PdfPig); server-provided
         assemblies are excluded at deploy time, not here -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>1.0.0.67</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.10" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="UglyToad.PdfPig.DocumentLayoutAnalysis" Version="1.7.0-custom-5" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
    <!-- Legacy binary Office (.doc/.ppt) converters, built from source and
         vendored: the b2xtranslator nuget ships only Common, not the Doc/Ppt
         mappers. Same self-built pattern as the custom PdfPig. -->
    <Reference Include="b2xtranslator">
      <HintPath>lib\b2xtranslator\b2xtranslator.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="b2xtranslator.doc">
      <HintPath>lib\b2xtranslator\b2xtranslator.doc.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="b2xtranslator.ppt">
      <HintPath>lib\b2xtranslator\b2xtranslator.ppt.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Inject\a11y-book-reader.js" />
    <EmbeddedResource Include="Inject\a11y-book-reader.css" />
    <EmbeddedResource Include="Fonts\OpenDyslexic-Regular.woff2" />
    <EmbeddedResource Include="Fonts\OpenDyslexic-Bold.woff2" />
    <EmbeddedResource Include="Fonts\OpenDyslexic-Italic.woff2" />
    <EmbeddedResource Include="PdfJs\pdf.min.mjs" />
    <EmbeddedResource Include="PdfJs\pdf.worker.min.mjs" />
    <!-- liblouis 3.38.0 (LGPL-2.1) braille back-translator, compiled to WASM
         with emscripten and bundled as a single self-contained file: the WASM
         engine and the UEB table closure are embedded, so the reader loads one
         asset and back-translates braille → print in-browser, no worker/XHR. -->
    <EmbeddedResource Include="LibLouis\liblouis.js" />
  </ItemGroup>

</Project>
